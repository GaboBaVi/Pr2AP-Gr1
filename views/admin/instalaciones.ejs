<%- include('../layouts/header') %>

<div class="row my-4">
  <div class="col-12">
    <div class="custom-card p-4">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h4 class="fw-bold mb-1">Gestión de Instalaciones y Calendario</h4>
          <span class="text-muted small">Ocupación real calculada según reservas activas y control de mantenimiento</span>
        </div>
        
        <!-- SELECTOR DE FECHA REAL -->
        <form action="/admin/instalaciones" method="GET" class="d-flex gap-2 align-items-center">
          <label class="small text-muted mb-0 fw-bold">Fecha:</label>
          <input type="date" name="fecha" value="<%= fecha %>" class="form-control form-control-custom form-control-sm" onchange="this.form.submit()">
        </form>
      </div>

      <% if (mensaje) { %>
        <div class="alert alert-info alert-dismissible fade show py-2 small mb-3" role="alert">
          <%= mensaje %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- TABLA EXACTA DE 5 COLUMNAS: HORARIO + 4 INSTALACIONES -->
      <div class="table-responsive">
        <table class="table table-bordered text-center align-middle small">
          <thead class="table-light">
            <tr>
              <th style="width: 20%;">Horario</th>
              <% instalaciones.forEach(inst => { %>
                <th style="width: 20%;">
                  <%= inst.nombre %><br>
                  <small class="text-muted font-monospace">(Aforo: <%= inst.aforo_maximo %>)</small>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% matriz.forEach(fila => { %>
              <tr>
                <td class="fw-bold bg-light text-start ps-3"><%= fila.horario %></td>
                <% instalaciones.forEach(inst => { %>
                  <% const celda = fila.instalaciones[inst.id] || { porcentaje: 0, personas: 0, bloqueada: false }; %>
                  <td>
                    <% if (celda.bloqueada) { %>
                      <span class="badge bg-danger py-1 px-2">MANTENIMIENTO</span>
                    <% } else if (celda.porcentaje === 0) { %>
                      <span class="badge bg-secondary py-1 px-2">0% (Libre)</span>
                    <% } else if (celda.porcentaje >= 100) { %>
                      <span class="badge bg-danger py-1 px-2">100% (Lleno)</span>
                    <% } else { %>
                      <span class="badge bg-success py-1 px-2"><%= celda.porcentaje %>% (<%= celda.personas %> p.)</span>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>

            <!-- FILA DE CONTROL DE MANTENIMIENTO -->
            <tr class="table-secondary fw-bold">
              <td class="text-start ps-3">Control de Mantenimiento</td>
              <% instalaciones.forEach(inst => { %>
                <td>
                  <% if (inst.bloqueada_mantenimiento) { %>
                    <div class="mb-1">
                      <small class="badge bg-danger">
                        <%= inst.mantenimiento_tipo === 'horas' && inst.mantenimiento_hora_inicio ? (inst.mantenimiento_hora_inicio.slice(0,5) + ' - ' + inst.mantenimiento_hora_fin.slice(0,5)) : 'Todo el día' %>
                      </small>
                    </div>
                    <form action="/admin/instalaciones/bloquear" method="POST" class="form-confirmar"
                          data-confirm-title="Habilitar Instalación"
                          data-confirm-msg="¿Confirmar restablecimiento de <strong><%= inst.nombre %></strong> para habilitarla nuevamente para reservas?"
                          data-confirm-btn="Habilitar Instalación"
                          data-confirm-type="success"
                          data-confirm-icon="bi-unlock-fill">
                      <input type="hidden" name="id" value="<%= inst.id %>">
                      <input type="hidden" name="fecha" value="<%= fecha %>">
                      <button type="submit" class="btn btn-sm btn-modern-success py-1 px-2 w-100 justify-content-center">
                        <i class="bi bi-unlock me-1"></i> Desbloquear
                      </button>
                    </form>
                  <% } else { %>
                    <button type="button" class="btn btn-sm btn-modern-neutral py-1 px-2 w-100 justify-content-center" data-bs-toggle="modal" data-bs-target="#modalBloqueo<%= inst.id %>">
                      <i class="bi bi-tools me-1"></i> Bloquear Mantenimiento
                    </button>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- MODALES DE BLOQUEO POR MANTENIMIENTO -->
<% instalaciones.forEach(inst => { %>
  <div class="modal fade" id="modalBloqueo<%= inst.id %>" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content custom-card p-3">
        <div class="modal-header border-0">
          <div>
            <h5 class="modal-title fw-bold mb-0">Bloquear por Mantenimiento</h5>
            <small class="text-muted"><%= inst.nombre %></small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/admin/instalaciones/bloquear" method="POST">
          <input type="hidden" name="id" value="<%= inst.id %>">
          <input type="hidden" name="fecha" value="<%= fecha %>">
          <div class="modal-body border-0">
            <div class="alert alert-warning py-2 small mb-3">
              <i class="bi bi-exclamation-triangle me-1"></i> Las reservas activas que coincidan con este horario serán canceladas automáticamente y se notificará por correo.
            </div>

            <div class="mb-3">
              <label class="form-label small text-muted fw-bold d-block">Modalidad de Mantenimiento</label>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="tipo_bloqueo" id="tipoDia<%= inst.id %>" value="todo_el_dia" checked onchange="toggleHorasMantenimiento(<%= inst.id %>)">
                <label class="form-check-label small" for="tipoDia<%= inst.id %>">Todo el día</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="tipo_bloqueo" id="tipoHoras<%= inst.id %>" value="horas" onchange="toggleHorasMantenimiento(<%= inst.id %>)">
                <label class="form-check-label small" for="tipoHoras<%= inst.id %>">Ciertas horas (ej. 8 a 12)</label>
              </div>
            </div>

            <!-- CONTENEDOR DE HORAS -->
            <div id="contenedorHoras<%= inst.id %>" class="row g-2 mb-3 d-none">
              <div class="col-6">
                <label class="form-label small text-muted fw-bold">Hora Inicio</label>
                <input type="time" name="hora_inicio" class="form-control form-control-custom" value="<%= inst.hora_apertura.slice(0,5) %>">
              </div>
              <div class="col-6">
                <label class="form-label small text-muted fw-bold">Hora Fin</label>
                <input type="time" name="hora_fin" class="form-control form-control-custom" value="12:00">
              </div>
              <div class="col-12">
                <span class="text-muted small">Ejemplo: de 08:00 a 12:00 mantendrá la instalación libre en la tarde.</span>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small text-muted fw-bold">Motivo del Mantenimiento</label>
              <input type="text" name="motivo" class="form-control form-control-custom" placeholder="Ej: Reparación, revisión técnica, limpieza profunda" required>
            </div>
          </div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-secondary btn-cancel-modal" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-modern-danger px-3 py-2 fw-semibold">Confirmar Bloqueo</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<script>
function toggleHorasMantenimiento(instId) {
  const radioHoras = document.getElementById('tipoHoras' + instId);
  const cont = document.getElementById('contenedorHoras' + instId);
  if (radioHoras && radioHoras.checked) {
    cont.classList.remove('d-none');
  } else {
    cont.classList.add('d-none');
  }
}
</script>

<%- include('../layouts/footer') %>
