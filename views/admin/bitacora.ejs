<%- include('../layouts/header') %>

<div class="row my-4">
  <div class="col-12">
    <div class="custom-card p-4">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h4 class="fw-bold mb-1">Bitácora de Envíos de Notificaciones</h4>
          <span class="text-muted small">Historial de correos electrónicos automáticos enviados</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <input type="text" class="form-control form-control-custom" style="height: 38px;" placeholder="Buscar socio o tipo..." id="busquedaBitacora">
          <a href="/admin/notificaciones" class="btn-volver"><i class="bi bi-arrow-left"></i> Volver</a>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle small">
          <thead class="table-light">
            <tr>
              <th>Socio</th>
              <th>Tipo de Notificación</th>
              <th>Asunto</th>
              <th>Estado de Entrega</th>
              <th>Fecha y Hora</th>
            </tr>
          </thead>
          <tbody>
            <% if (logs && logs.length > 0) { %>
              <% logs.forEach(l => { %>
                <tr>
                  <td class="fw-bold"><%= l.nombre_socio || l.destinatario_correo %></td>
                  <td><%= l.tipo_notificacion %></td>
                  <td><%= l.asunto %></td>
                  <td>
                    <span class="badge bg-<%= l.estado_entrega === 'Entregado' ? 'success' : (l.estado_entrega === 'Visto' ? 'info text-dark' : 'warning text-dark') %>">
                      <%= l.estado_entrega %>
                    </span>
                  </td>
                  <td><%= new Date(l.fecha_envio).toLocaleString() %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <!-- Registros de muestra coincidentes con el prototipo -->
              <tr>
                <td class="fw-bold">Daniel Zumbado Hidalgo</td>
                <td>Cuenta Desactivada</td>
                <td>Notificación sobre el estado de tu cuenta</td>
                <td><span class="badge bg-info text-dark">Visto</span></td>
                <td>16/10/2026</td>
              </tr>
              <tr>
                <td class="fw-bold">Valeria Castro Jiménez</td>
                <td>Recordatorio de Pago Pendiente</td>
                <td>Aviso de Pago Pendiente - Club Valle Alto</td>
                <td><span class="badge bg-success">Entregado</span></td>
                <td>15/10/2026</td>
              </tr>
              <tr>
                <td class="fw-bold">Carlos Mora Vargas</td>
                <td>Confirmación de Membresía Platino</td>
                <td>Bienvenida a Club Valle Alto</td>
                <td><span class="badge bg-info text-dark">Visto</span></td>
                <td>14/10/2026</td>
              </tr>
              <tr>
                <td class="fw-bold">Diego Rojas Salazar</td>
                <td>Aviso de Reserva en Cancha</td>
                <td>Confirmación de tu Reserva en Club Valle Alto</td>
                <td><span class="badge bg-success">Entregado</span></td>
                <td>12/10/2026</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
