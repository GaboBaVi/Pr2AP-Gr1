<%- include('../layouts/header') %>

<div class="row my-4">
  <div class="col-12">
    <div class="custom-card p-4">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h4 class="fw-bold mb-1">Centro de Notificaciones</h4>
          <span class="text-muted small">Configuración de plantillas automáticas por correo electrónico</span>
        </div>
        <a href="/admin/bitacora-notificaciones" class="btn-dark-pill btn-sm-pill">Bitácora de Envíos</a>
      </div>

      <% if (mensaje) { %>
        <div class="alert alert-success py-2 small mb-3">
          <%= mensaje %>
        </div>
      <% } %>

      <!-- CARRUSEL / TABS DE PLANTILLAS -->
      <ul class="nav nav-pills mb-4 nav-fill" id="templatesTab" role="tablist">
        <% plantillas.forEach((p, idx) => { %>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= idx === 0 ? 'active bg-dark' : 'text-dark' %>" 
                    id="tab-<%= p.clave %>" 
                    data-bs-toggle="pill" 
                    data-bs-target="#pane-<%= p.clave %>" 
                    type="button">
              <%= p.nombre %>
            </button>
          </li>
        <% }) %>
      </ul>

      <div class="tab-content" id="templatesTabContent">
        <% plantillas.forEach((p, idx) => { %>
          <div class="tab-pane fade <%= idx === 0 ? 'show active' : '' %>" id="pane-<%= p.clave %>">
            <div class="card p-4 border-0 shadow-sm bg-white rounded-4">
              <form action="/admin/notificaciones/plantilla" method="POST">
                <input type="hidden" name="clave" value="<%= p.clave %>">
                
                <div class="mb-3">
                  <label class="form-label fw-bold small text-muted">Asunto del Correo</label>
                  <input type="text" name="asunto" class="form-control form-control-custom" value="<%= p.asunto %>" required>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold small text-muted">Cuerpo del Mensaje (Variables soportadas: {{nombre}}, {{instalacion}}, {{fecha}}, {{monto}})</label>
                  <textarea name="cuerpo" rows="6" class="form-control form-control-custom" required><%= p.cuerpo %></textarea>
                </div>

                <div class="text-end">
                  <button type="submit" class="btn-dark-pill btn-sm-pill px-4">Modificar Plantilla</button>
                </div>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
