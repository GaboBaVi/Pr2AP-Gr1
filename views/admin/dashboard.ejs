          </div>
        </div>
        <div class="col-md-6">
          <div class="hero-img-box">
            <img src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80" alt="Club Valle Alto Admin">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
