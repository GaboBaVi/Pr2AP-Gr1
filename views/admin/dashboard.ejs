<%- include('../layouts/header') %>

<div class="row align-items-center justify-content-center my-4">
  <div class="col-lg-10">
    <div class="custom-card p-5">
      <div class="row align-items-center">
        <div class="col-md-6 mb-4 mb-md-0">
