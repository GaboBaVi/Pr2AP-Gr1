<%- include('../layouts/header') %>

<div class="row justify-content-center my-4">
  <div class="col-md-5">
    <div class="custom-card p-4 p-md-5">
      <h2 class="text-center fw-bold mb-4">Iniciar Sesión</h2>

      <% if (error) { %>
        <div class="alert alert-danger py-2 small" role="alert">
          <%= error %>
        </div>
      <% } %>

      <% if (exito) { %>
        <div class="alert alert-success py-2 small" role="alert">
          <%= exito %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST">
        <div class="mb-3">
          <input type="email" name="correo" class="form-control form-control-custom" placeholder="Correo Electrónico" required>
        </div>
        <div class="mb-2">
          <input type="password" name="password" class="form-control form-control-custom" placeholder="Contraseña" required>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4 small">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="recuerdame">
            <label class="form-check-label text-muted" for="recuerdame">Recuérdame</label>
          </div>
          <a href="/auth/recovery" class="text-decoration-none fw-semibold text-dark">¿Olvidaste tu Contraseña?</a>
        </div>

        <div class="text-center mb-3">
          <button type="submit" class="btn-dark-pill w-100 py-2">Iniciar Sesión</button>
        </div>

        <div class="text-center small mt-3">
          <span class="text-muted">¿No tienes cuenta?</span> 
          <a href="/auth/register" class="fw-bold text-dark text-decoration-none">Regístrate</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
