<%- include('../layouts/header') %>

<div class="row justify-content-center my-3">
  <div class="col-lg-11">
    <div class="custom-card p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3 class="fw-bold mb-0">Formulario de Reservas e Invitados</h3>
        <a href="/socio/reservas" class="btn btn-sm btn-outline-secondary rounded-pill">Volver</a>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2 small mb-4" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <form action="/socio/reservar" method="POST" id="formReserva">
        <div class="row g-4">
          <!-- PASO 1: SELECCION DE INSTALACION -->
          <div class="col-md-3">
            <div class="border rounded-4 p-3 bg-white h-100">
              <span class="badge bg-secondary mb-2">Paso #1</span>
              <h6 class="fw-bold mb-3">Selección de la Instalación</h6>
              <div class="mb-3">
                <select name="instalacion_id" id="selectInstalacion" class="form-select form-control-custom" required onchange="actualizarDetallesInstalacion()">
                  <option value="" disabled <%= !datosPrevios.instalacion_id ? 'selected' : '' %>>Selecciona instalación...</option>
                  <% instalaciones.forEach(inst => { %>
                    <option value="<%= inst.id %>" 
                            data-aforo="<%= inst.aforo_maximo %>" 
                            data-apertura="<%= inst.hora_apertura.slice(0,5) %>" 
                            data-cierre="<%= inst.hora_cierre.slice(0,5) %>"
                            <%= String(datosPrevios.instalacion_id) === String(inst.id) ? 'selected' : '' %>
                            <%= inst.bloqueada_mantenimiento ? 'disabled' : '' %>>
                      <%= inst.nombre %> <%= inst.bloqueada_mantenimiento ? '(Bloqueada por Mantenimiento)' : '' %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <!-- BANNER DINAMICO DE DETALLES DE LA INSTALACION -->
              <div id="infoInstalacion" class="alert alert-info py-2 small d-none mb-0">
                <strong>Aforo Máximo:</strong> <span id="txtAforo">-</span> personas<br>
                <strong>Horario:</strong> <span id="txtHorario">-</span>
              </div>
            </div>
          </div>

          <!-- PASO 2: FECHA, HORA Y AFORO -->
          <div class="col-md-3">
            <div class="border rounded-4 p-3 bg-white h-100 d-flex flex-column">
              <span class="badge bg-secondary mb-2 align-self-start">Paso #2</span>
              <h6 class="fw-bold mb-3">Indicar Fecha, Hora y Aforo</h6>
              
              <div class="mb-2">
                <label class="form-label small text-muted mb-0 fw-bold">Fecha de Reserva</label>
                <input type="date" name="fecha" id="inputFecha" class="form-control form-control-custom" value="<%= datosPrevios.fecha || '' %>" required onchange="cargarHorariosDisponibles()">
              </div>

              <!-- SELECTOR DE HORARIOS DISPONIBLES (SOLO LIBRES) -->
              <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label small text-muted mb-0 fw-bold">Horas Disponibles</label>
                  <small id="spinnerCarga" class="text-muted d-none"><span class="spinner-border spinner-border-sm me-1"></span>Buscando...</small>
                </div>

                <div id="avisoSeleccionPrevia" class="text-muted small py-2">
                  <i class="bi bi-info-circle me-1"></i> Selecciona la instalación y la fecha para consultar horas disponibles.
                </div>

                <div id="avisoSinHorarios" class="alert alert-warning py-2 small d-none mb-2">
                  No hay horarios disponibles para esta instalación en la fecha seleccionada.
                </div>

                <!-- CONTENEDOR DE BOTONES DE HORARIOS LIBRES -->
                <div id="contenedorChipsHorarios" class="d-flex flex-column gap-1 mb-2 d-none" style="max-height: 190px; overflow-y: auto;">
                  <!-- Se generan dinámicamente -->
                </div>

                <!-- RESUMEN DEL HORARIO SELECCIONADO -->
                <div id="cajaResumenHorario" class="p-2 bg-light rounded-3 small d-none mb-2 border">
                  <div class="fw-bold text-dark" id="txtResumenHorario">Horario: -</div>
                  <div class="text-muted small" id="txtDuracionHorario">Selecciona uno o varios bloques continuos</div>
                </div>

                <!-- INPUTS OCULTOS DE HORA INICIO Y FIN -->
                <input type="hidden" name="hora_inicio" id="inputHoraInicio" value="<%= datosPrevios.hora_inicio || '' %>" required>
                <input type="hidden" name="hora_fin" id="inputHoraFin" value="<%= datosPrevios.hora_fin || '' %>" required>
              </div>

              <div class="mb-2 mt-auto">
                <label class="form-label small text-muted mb-0 fw-bold">Número de Personas</label>
                <input type="number" name="num_personas" id="inputNumPersonas" min="1" max="100" class="form-control form-control-custom" value="<%= datosPrevios.num_personas || 1 %>" required>
              </div>
            </div>
          </div>

          <!-- PASO 3: SERVICIOS ADICIONALES (FILTRADOS POR INSTALACION) -->
          <div class="col-md-3">
            <div class="border rounded-4 p-3 bg-white h-100">
              <span class="badge bg-secondary mb-2">Paso #3</span>
              <h6 class="fw-bold mb-2">Servicios Adicionales</h6>
              <p class="small text-muted mb-3">Opciones según instalación</p>
              
              <div id="sinServicios" class="text-muted small">Selecciona una instalación para ver los servicios disponibles.</div>

              <!-- GOLF (ID 1) -->
              <div class="servicio-item d-none" data-inst="1">
                <div class="form-check mb-2 small">
                  <input class="form-check-input check-servicio" type="checkbox" name="servicios_adicionales" value="palos_golf" id="s1">
                  <label class="form-check-label" for="s1">Palos de Golf (CRC 15,000)</label>
                </div>
                <div class="form-check mb-2 small">
                  <input class="form-check-input check-servicio" type="checkbox" name="servicios_adicionales" value="pelotas_golf" id="s2">
                  <label class="form-check-label" for="s2">Pelotas Golf (CRC 5,000)</label>
                </div>
              </div>

              <!-- TENIS (ID 2) -->
              <div class="servicio-item d-none" data-inst="2">
                <div class="form-check mb-2 small">
                  <input class="form-check-input check-servicio" type="checkbox" name="servicios_adicionales" value="raquetas" id="s3">
                  <label class="form-check-label" for="s3">Raquetas Tenis (CRC 6,000)</label>
                </div>
                <div class="form-check mb-2 small">
                  <input class="form-check-input check-servicio" type="checkbox" name="servicios_adicionales" value="pelotas_tenis" id="s4">
                  <label class="form-check-label" for="s4">Pelotas Tenis (CRC 3,000)</label>
                </div>
              </div>

              <!-- PISCINA (ID 3) -->
              <div class="servicio-item d-none" data-inst="3">
                <div class="form-check mb-2 small">
                  <input class="form-check-input check-servicio" type="checkbox" name="servicios_adicionales" value="piscina" id="s5">
                  <label class="form-check-label" for="s5">Accesorios Piscina (CRC 2,500)</label>
                </div>
              </div>

              <!-- SALON (ID 4) -->
              <div class="servicio-item d-none" data-inst="4">
                <div class="form-check mb-2 small">
                  <input class="form-check-input check-servicio" type="checkbox" name="servicios_adicionales" value="mobiliario" id="s6">
                  <label class="form-check-label" for="s6">Mobiliario & Sonido (CRC 45,000)</label>
                </div>
              </div>
            </div>
          </div>

          <!-- PASO 4: REGISTRO DE INVITADO -->
          <div class="col-md-3">
            <div class="border rounded-4 p-3 bg-white h-100">
              <span class="badge bg-secondary mb-2">Paso #4</span>
              <h6 class="fw-bold mb-2">Registro de Invitado</h6>
              <p class="small text-muted mb-3">(Acompañante externo)</p>

              <div class="mb-2">
                <input type="text" name="invitado_nombre" class="form-control form-control-custom" placeholder="Nombre acompañante" value="<%= datosPrevios.invitado_nombre || '' %>">
              </div>
              <div class="mb-2">
                <input type="text" name="invitado_cedula" class="form-control form-control-custom" placeholder="Cédula (ej. 1-1234-0567)" pattern="^(?:[1-9]-?\d{4}-?\d{4}|\d{9}|\d{11,12})?$" title="Formato: 9 dígitos costarricense" value="<%= datosPrevios.invitado_cedula || '' %>">
              </div>
              <div class="mb-3">
                <input type="text" name="invitado_parentesco" class="form-control form-control-custom" placeholder="Parentesco o Relación" value="<%= datosPrevios.invitado_parentesco || '' %>">
              </div>
              <small class="text-muted d-block mb-3">
                Los invitados registrados aparecerán en el detalle de la reserva y en la lista de recepción para control de acceso.
              </small>
            </div>
          </div>
        </div>

        <div class="text-center mt-5">
          <button type="submit" class="btn-dark-pill px-5 py-2">Confirmar Reserva</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function obtenerFechaHoy() {
  const ahora = new Date();
  const anio = ahora.getFullYear();
  const mes = String(ahora.getMonth() + 1).padStart(2, '0');
  const dia = String(ahora.getDate()).padStart(2, '0');
  return `${anio}-${mes}-${dia}`;
}

function obtenerHoraActual() {
  const ahora = new Date();
  const horas = String(ahora.getHours()).padStart(2, '0');
  const minutos = String(ahora.getMinutes()).padStart(2, '0');
  return `${horas}:${minutos}`;
}

function validarFechaYHoras() {
  const inputFecha = document.getElementById('inputFecha');
  const inputHoraInicio = document.getElementById('inputHoraInicio');
  const hoy = obtenerFechaHoy();

  if (inputFecha.value === hoy) {
    const horaActual = obtenerHoraActual();
    // Si la fecha es hoy, la hora de inicio minima es la hora actual
    inputHoraInicio.min = horaActual;
  }
}

function actualizarDetallesInstalacion() {
  const select = document.getElementById('selectInstalacion');
  const selectedOption = select.options[select.selectedIndex];
  const infoBox = document.getElementById('infoInstalacion');
  const sinServicios = document.getElementById('sinServicios');

  if (selectedOption && selectedOption.value) {
    const aforo = selectedOption.getAttribute('data-aforo');
    const apertura = selectedOption.getAttribute('data-apertura');
    const cierre = selectedOption.getAttribute('data-cierre');

    document.getElementById('txtAforo').innerText = aforo;
    document.getElementById('txtHorario').innerText = `${apertura} a ${cierre}`;
    infoBox.classList.remove('d-none');

    // Ajustar max del input personas
    const inputPersonas = document.getElementById('inputNumPersonas');
    inputPersonas.max = aforo;

    // Ajustar min/max horas
    document.getElementById('inputHoraInicio').min = apertura;
    document.getElementById('inputHoraInicio').max = cierre;
    document.getElementById('inputHoraFin').min = apertura;
    document.getElementById('inputHoraFin').max = cierre;

    // Cargar horarios disponibles para la nueva instalacion
    cargarHorariosDisponibles();

    // Mostrar solo servicios de esta instalacion
    const instId = selectedOption.value;
    sinServicios.classList.add('d-none');
    document.querySelectorAll('.servicio-item').forEach(div => {
      if (div.getAttribute('data-inst') === instId) {
        div.classList.remove('d-none');
      } else {
        div.classList.add('d-none');
        div.querySelectorAll('.check-servicio').forEach(chk => chk.checked = false);
      }
    });
  } else {
    infoBox.classList.add('d-none');
    sinServicios.classList.remove('d-none');
  }
}

// GESTIÓN DINÁMICA DE HORARIOS DISPONIBLES (SOLO HORAS LIBRES)
let slotsDisponibles = [];
let indicesSeleccionados = [];

function formatHora12(h24) {
  if (!h24) return '';
  const parts = h24.slice(0, 5).split(':');
  let h = parseInt(parts[0], 10);
  const m = parts[1];
  const ampm = h >= 12 ? 'pm' : 'am';
  h = h % 12 || 12;
  return `${h}:${m} ${ampm}`;
}

async function cargarHorariosDisponibles() {
  const selectInst = document.getElementById('selectInstalacion');
  const inputFecha = document.getElementById('inputFecha');
  const spinner = document.getElementById('spinnerCarga');
  const avisoPrevia = document.getElementById('avisoSeleccionPrevia');
  const avisoSin = document.getElementById('avisoSinHorarios');
  const contChips = document.getElementById('contenedorChipsHorarios');
  const cajaResumen = document.getElementById('cajaResumenHorario');
  const inputInicio = document.getElementById('inputHoraInicio');
  const inputFin = document.getElementById('inputHoraFin');

  const instId = selectInst.value;
  const fecha = inputFecha.value;

  // Resetear selección
  indicesSeleccionados = [];
  inputInicio.value = '';
  inputFin.value = '';
  cajaResumen.classList.add('d-none');

  if (!instId || !fecha) {
    avisoPrevia.classList.remove('d-none');
    avisoSin.classList.add('d-none');
    contChips.classList.add('d-none');
    return;
  }

  avisoPrevia.classList.add('d-none');
  avisoSin.classList.add('d-none');
  contChips.classList.add('d-none');
  spinner.classList.remove('d-none');

  try {
    const res = await fetch(`/socio/reservas/disponibilidad-horaria?instalacion_id=${instId}&fecha=${fecha}`);
    const data = await res.json();
    spinner.classList.add('d-none');

    if (!data.disponible || !data.slots || data.slots.length === 0) {
      avisoSin.textContent = data.motivo || 'No hay horarios disponibles para esta fecha (horas pasadas, reservadas o en mantenimiento).';
      avisoSin.classList.remove('d-none');
      contChips.classList.add('d-none');
      slotsDisponibles = [];
      return;
    }

    slotsDisponibles = data.slots;
    contChips.innerHTML = '';
    contChips.classList.remove('d-none');

    slotsDisponibles.forEach((slot, index) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-sm btn-outline-dark chip-horario py-1 px-2 text-start';
      btn.style.fontSize = '0.78rem';
      btn.style.borderRadius = '6px';
      btn.innerHTML = `<i class="bi bi-clock me-1"></i> ${slot.label}`;
      btn.onclick = () => manejarClickSlot(index);
      contChips.appendChild(btn);
    });

    // Si había horas previas por error de validación, intentar restaurar selección
    const horaInicioPrevia = "<%= datosPrevios.hora_inicio || '' %>";
    const horaFinPrevia = "<%= datosPrevios.hora_fin || '' %>";
    if (horaInicioPrevia && horaFinPrevia) {
      preseleccionarRango(horaInicioPrevia, horaFinPrevia);
    }
  } catch (err) {
    spinner.classList.add('d-none');
    avisoSin.textContent = 'Error al consultar disponibilidad de horarios.';
    avisoSin.classList.remove('d-none');
    console.error(err);
  }
}

function manejarClickSlot(index) {
  if (indicesSeleccionados.length === 0) {
    // Primer clic: selecciona solo este tiempo
    indicesSeleccionados = [index];
  } else if (indicesSeleccionados.length === 1 && indicesSeleccionados[0] === index) {
    // Si vuelve a cliquear el mismo, se mantiene seleccionado
    indicesSeleccionados = [index];
  } else {
    // Clic en otro slot: selección de rango continuo
    const minIdx = Math.min(indicesSeleccionados[0], index);
    const maxIdx = Math.max(indicesSeleccionados[indicesSeleccionados.length - 1], index);

    // Verificar si todos los slots intermedios están en la lista (sin huecos reservados)
    let continuo = true;
    const nuevoRango = [];
    for (let i = minIdx; i <= maxIdx; i++) {
      nuevoRango.push(i);
      if (i > minIdx) {
        if (slotsDisponibles[i].hora_inicio !== slotsDisponibles[i - 1].hora_fin) {
          continuo = false;
          break;
        }
      }
    }

    if (continuo) {
      indicesSeleccionados = nuevoRango;
    } else {
      // Si hay un espacio reservado intermedio, reinicia la selección en el nuevo slot
      indicesSeleccionados = [index];
    }
  }

  actualizarUISeleccionHorarios();
}

function preseleccionarRango(inicio, fin) {
  const iniShort = inicio.slice(0, 5);
  const finShort = fin.slice(0, 5);
  const seleccion = [];
  slotsDisponibles.forEach((s, idx) => {
    if (s.hora_inicio >= iniShort && s.hora_fin <= finShort) {
      seleccion.push(idx);
    }
  });
  if (seleccion.length > 0) {
    indicesSeleccionados = seleccion;
    actualizarUISeleccionHorarios();
  }
}

function actualizarUISeleccionHorarios() {
  const chips = document.querySelectorAll('.chip-horario');
  const inputInicio = document.getElementById('inputHoraInicio');
  const inputFin = document.getElementById('inputHoraFin');
  const cajaResumen = document.getElementById('cajaResumenHorario');
  const txtResumen = document.getElementById('txtResumenHorario');
  const txtDuracion = document.getElementById('txtDuracionHorario');

  chips.forEach((chip, idx) => {
    if (indicesSeleccionados.includes(idx)) {
      chip.className = 'btn btn-sm btn-dark text-white chip-horario py-1 px-2 text-start';
    } else {
      chip.className = 'btn btn-sm btn-outline-dark chip-horario py-1 px-2 text-start';
    }
  });

  if (indicesSeleccionados.length > 0) {
    const primerSlot = slotsDisponibles[indicesSeleccionados[0]];
    const ultimoSlot = slotsDisponibles[indicesSeleccionados[indicesSeleccionados.length - 1]];

    inputInicio.value = primerSlot.hora_inicio;
    inputFin.value = ultimoSlot.hora_fin;

    const horasTotales = indicesSeleccionados.length;
    cajaResumen.classList.remove('d-none');
    txtResumen.innerHTML = `<i class="bi bi-check-circle-fill text-success me-1"></i> ${formatHora12(primerSlot.hora_inicio)} a ${formatHora12(ultimoSlot.hora_fin)}`;
    txtDuracion.textContent = horasTotales === 1 
      ? '1 hora seleccionada (solo un tiempo)' 
      : `${horasTotales} horas seleccionadas (varios tiempos continuos)`;
  } else {
    inputInicio.value = '';
    inputFin.value = '';
    cajaResumen.classList.add('d-none');
  }
}

// Validacion estricta al enviar el formulario
document.getElementById('formReserva').addEventListener('submit', function(e) {
  const inputFecha = document.getElementById('inputFecha');
  const inputHoraInicio = document.getElementById('inputHoraInicio');
  const inputHoraFin = document.getElementById('inputHoraFin');
  const hoy = obtenerFechaHoy();
  const horaActual = obtenerHoraActual();

  if (!inputHoraInicio.value || !inputHoraFin.value) {
    e.preventDefault();
    alert('Debes seleccionar al menos un horario disponible en el Paso #2 antes de continuar.');
    return;
  }

  if (inputFecha.value < hoy) {
    e.preventDefault();
    alert('No puedes seleccionar una fecha pasada.');
    return;
  }

  if (inputFecha.value === hoy && inputHoraInicio.value <= horaActual) {
    e.preventDefault();
    alert(`La hora de inicio (${inputHoraInicio.value}) ya ha transcurrido. Por favor selecciona una hora posterior a las ${horaActual}.`);
    return;
  }

  if (inputHoraInicio.value >= inputHoraFin.value) {
    e.preventDefault();
    alert('La hora de inicio debe ser anterior a la hora de finalización.');
    return;
  }
});

// Ejecutar al cargar
document.addEventListener('DOMContentLoaded', () => {
  const inputFecha = document.getElementById('inputFecha');
  const hoy = obtenerFechaHoy();
  inputFecha.min = hoy;
  actualizarDetallesInstalacion();
  cargarHorariosDisponibles();
});
</script>

<%- include('../layouts/footer') %>
