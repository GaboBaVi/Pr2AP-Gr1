<%- include('../layouts/header') %>

<div class="row justify-content-center my-3">
  <div class="col-lg-8">
    <div class="custom-card p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Modificar Reserva</h3>
        <a href="/socio/reservas" class="btn btn-sm btn-outline-secondary rounded-pill">Volver</a>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2 small mb-4" role="alert">
          <%= error %>
        </div>
      <% } %>

      <form action="/socio/reservas/editar/<%= reserva.id %>" method="POST">
        <div class="row g-3">
          <!-- INSTALACION -->
          <div class="col-12">
            <label class="form-label small fw-bold text-muted">Instalación</label>
            <select name="instalacion_id" class="form-select form-control-custom" required>
              <% instalaciones.forEach(inst => { %>
                <option value="<%= inst.id %>" <%= inst.id === reserva.instalacion_id ? 'selected' : '' %> <%= inst.bloqueada_mantenimiento ? 'disabled' : '' %>>
                  <%= inst.nombre %> (Aforo máx: <%= inst.aforo_maximo %> personas) <%= inst.bloqueada_mantenimiento ? '[BLOQUEADA]' : '' %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- FECHA Y HORARIO -->
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Fecha</label>
            <input type="date" name="fecha" class="form-control form-control-custom" value="<%= new Date(reserva.fecha).toISOString().split('T')[0] %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Hora de Inicio</label>
            <input type="time" name="hora_inicio" class="form-control form-control-custom" value="<%= reserva.hora_inicio.slice(0,5) %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Hora de Fin</label>
            <input type="time" name="hora_fin" class="form-control form-control-custom" value="<%= reserva.hora_fin.slice(0,5) %>" required>
          </div>

          <!-- NUMERO DE PERSONAS -->
          <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Número de Personas</label>
            <input type="number" name="num_personas" class="form-control form-control-custom" value="<%= reserva.num_personas %>" min="1" required>
          </div>

          <!-- SERVICIOS ADICIONALES -->
          <div class="col-12 mt-4">
            <label class="form-label small fw-bold text-muted">Servicios Adicionales (Opcional)</label>
            <div class="row g-2">
              <div class="col-md-6">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="palos_golf" id="s1">
                  <label class="form-check-label" for="s1">Palos de Golf (CRC 15,000)</label>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="pelotas_golf" id="s2">
                  <label class="form-check-label" for="s2">Pelotas de Golf (CRC 5,000)</label>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="raquetas" id="s3">
                  <label class="form-check-label" for="s3">Raquetas Tenis (CRC 6,000)</label>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="mobiliario" id="s6">
                  <label class="form-check-label" for="s6">Montaje Mobiliario (CRC 45,000)</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-5">
          <button type="submit" class="btn-dark-pill px-5 py-2">Guardar Modificaciones</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
