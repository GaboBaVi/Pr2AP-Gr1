<%- include('../layouts/header') %>

<div class="row justify-content-center my-3">
  <div class="col-lg-8">
    <div class="custom-card p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Modificar Reserva</h3>
        <a href="/socio/reservas" class="btn btn-sm btn-outline-secondary rounded-pill">Volver</a>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2 small mb-4" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <form action="/socio/reservas/editar/<%= reserva.id %>" method="POST">
        <div class="row g-3">
          <!-- INSTALACION -->
          <div class="col-12">
            <label class="form-label small fw-bold text-muted">Instalación</label>
            <select name="instalacion_id" id="editInstalacion" class="form-select form-control-custom" required onchange="actualizarServiciosEdit()">
              <% instalaciones.forEach(inst => { %>
                <option value="<%= inst.id %>" 
                        data-aforo="<%= inst.aforo_maximo %>"
                        data-apertura="<%= inst.hora_apertura.slice(0,5) %>"
                        data-cierre="<%= inst.hora_cierre.slice(0,5) %>"
                        <%= inst.id === reserva.instalacion_id ? 'selected' : '' %>>
                  <%= inst.nombre %> (Aforo máx: <%= inst.aforo_maximo %> personas)
                </option>
              <% }) %>
            </select>
          </div>

          <!-- FECHA Y HORARIO -->
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Fecha</label>
            <input type="date" name="fecha" id="editFecha" class="form-control form-control-custom" value="<%= new Date(reserva.fecha).toISOString().split('T')[0] %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Hora de Inicio</label>
            <input type="time" name="hora_inicio" id="editHoraInicio" class="form-control form-control-custom" value="<%= reserva.hora_inicio.slice(0,5) %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Hora de Fin</label>
            <input type="time" name="hora_fin" id="editHoraFin" class="form-control form-control-custom" value="<%= reserva.hora_fin.slice(0,5) %>" required>
          </div>

          <!-- NUMERO DE PERSONAS -->
          <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Número de Personas</label>
            <input type="number" name="num_personas" id="editNumPersonas" class="form-control form-control-custom" value="<%= reserva.num_personas %>" min="1" required>
          </div>

          <!-- SERVICIOS ADICIONALES (FILTRADOS Y CON CHECKMARKS PREVIOS) -->
          <div class="col-12 mt-4">
            <label class="form-label small fw-bold text-muted">Servicios Adicionales (Selecciona los requeridos)</label>
            <div class="row g-2">
              <!-- GOLF -->
              <div class="col-md-6 edit-servicio" data-inst="1">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="palos_golf" id="es1" <%= serviciosPrevios.includes('Alquiler de Palos de Golf') ? 'checked' : '' %>>
                  <label class="form-check-label" for="es1">Palos de Golf (CRC 15,000)</label>
                </div>
              </div>
              <div class="col-md-6 edit-servicio" data-inst="1">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="pelotas_golf" id="es2" <%= serviciosPrevios.includes('Alquiler de Pelotas de Golf') ? 'checked' : '' %>>
                  <label class="form-check-label" for="es2">Pelotas de Golf (CRC 5,000)</label>
                </div>
              </div>

              <!-- TENIS -->
              <div class="col-md-6 edit-servicio" data-inst="2">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="raquetas" id="es3" <%= serviciosPrevios.includes('Alquiler de Raquetas de Tenis') ? 'checked' : '' %>>
                  <label class="form-check-label" for="es3">Raquetas Tenis (CRC 6,000)</label>
                </div>
              </div>
              <div class="col-md-6 edit-servicio" data-inst="2">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="pelotas_tenis" id="es4" <%= serviciosPrevios.includes('Alquiler de Pelotas de Tenis') ? 'checked' : '' %>>
                  <label class="form-check-label" for="es4">Pelotas Tenis (CRC 3,000)</label>
                </div>
              </div>

              <!-- PISCINA -->
              <div class="col-md-6 edit-servicio" data-inst="3">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="piscina" id="es5" <%= serviciosPrevios.includes('Accesorios para Piscina') ? 'checked' : '' %>>
                  <label class="form-check-label" for="es5">Accesorios Piscina (CRC 2,500)</label>
                </div>
              </div>

              <!-- SALON -->
              <div class="col-md-6 edit-servicio" data-inst="4">
                <div class="form-check small">
                  <input class="form-check-input" type="checkbox" name="servicios_adicionales" value="mobiliario" id="es6" <%= serviciosPrevios.includes('Montaje de Mobiliario y Sonido') ? 'checked' : '' %>>
                  <label class="form-check-label" for="es6">Montaje Mobiliario & Sonido (CRC 45,000)</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-5">
          <button type="submit" class="btn-dark-pill px-5 py-2">Guardar Modificaciones</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function obtenerFechaHoy() {
  const ahora = new Date();
  const anio = ahora.getFullYear();
  const mes = String(ahora.getMonth() + 1).padStart(2, '0');
  const dia = String(ahora.getDate()).padStart(2, '0');
  return `${anio}-${mes}-${dia}`;
}

function obtenerHoraActual() {
  const ahora = new Date();
  const horas = String(ahora.getHours()).padStart(2, '0');
  const minutos = String(ahora.getMinutes()).padStart(2, '0');
  return `${horas}:${minutos}`;
}

function actualizarServiciosEdit() {
  const select = document.getElementById('editInstalacion');
  const selectedOption = select.options[select.selectedIndex];
  if (selectedOption) {
    const instId = selectedOption.value;
    const aforo = selectedOption.getAttribute('data-aforo');
    const apertura = selectedOption.getAttribute('data-apertura');
    const cierre = selectedOption.getAttribute('data-cierre');

    document.getElementById('editNumPersonas').max = aforo;
    document.getElementById('editHoraInicio').min = apertura;
    document.getElementById('editHoraInicio').max = cierre;
    document.getElementById('editHoraFin').min = apertura;
    document.getElementById('editHoraFin').max = cierre;

    document.querySelectorAll('.edit-servicio').forEach(div => {
      if (div.getAttribute('data-inst') === instId) {
        div.classList.remove('d-none');
      } else {
        div.classList.add('d-none');
        div.querySelector('input').checked = false;
      }
    });
  }
}

document.querySelector('form').addEventListener('submit', function(e) {
  const inputFecha = document.getElementById('editFecha');
  const inputHoraInicio = document.getElementById('editHoraInicio');
  const inputHoraFin = document.getElementById('editHoraFin');
  const hoy = obtenerFechaHoy();
  const horaActual = obtenerHoraActual();

  if (inputFecha.value < hoy) {
    e.preventDefault();
    alert('No puedes seleccionar una fecha pasada.');
    return;
  }

  if (inputFecha.value === hoy && inputHoraInicio.value <= horaActual) {
    e.preventDefault();
    alert(`La hora de inicio (${inputHoraInicio.value}) ya ha transcurrido. Por favor selecciona una hora posterior a las ${horaActual}.`);
    return;
  }

  if (inputHoraInicio.value >= inputHoraFin.value) {
    e.preventDefault();
    alert('La hora de inicio debe ser anterior a la hora de finalización.');
    return;
  }
});

document.addEventListener('DOMContentLoaded', () => {
  const inputFecha = document.getElementById('editFecha');
  inputFecha.min = obtenerFechaHoy();
  actualizarServiciosEdit();
});
</script>

<%- include('../layouts/footer') %>
