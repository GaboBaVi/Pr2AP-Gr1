<%- include('../layouts/header') %>

<div class="row g-4 my-3">
  <% if (mensaje) { %>
    <div class="col-12">
      <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <%= mensaje %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="col-12">
      <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  <% } %>

  <!-- COLUMNA PRINCIPAL: HISTORIAL DE RESERVAS CON PESTAÑAS -->
  <div class="col-lg-8">
    <div class="custom-card">
      <!-- PESTAÑAS SEGMENTADAS MODERNAS -->
      <ul class="nav segmented-tabs mb-4">
        <li class="nav-item">
          <a class="nav-link <%= estadoActual === 'activa' ? 'active' : '' %>" href="/socio/reservas?estado=activa">
            <i class="bi bi-calendar-check me-1"></i> Activas
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= estadoActual === 'finalizada' ? 'active' : '' %>" href="/socio/reservas?estado=finalizada">
            <i class="bi bi-check2-circle me-1"></i> Finalizadas
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= estadoActual === 'cancelada' ? 'active' : '' %>" href="/socio/reservas?estado=cancelada">
            <i class="bi bi-x-circle me-1"></i> Canceladas
          </a>
        </li>
      </ul>

      <h5 class="fw-bold mb-3">Mis Reservas <%= estadoActual.charAt(0).toUpperCase() + estadoActual.slice(1) %>s</h5>

      <% if (reservas.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <p>No tienes reservas <%= estadoActual %>s registradas en este momento.</p>
        </div>
      <% } else { %>
        <div class="d-flex flex-column gap-3">
          <% reservas.forEach(r => { %>
            <div class="border rounded-3 p-3 bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <h6 class="fw-bold mb-1"><%= r.nombre_instalacion %></h6>
                <p class="small text-muted mb-1">
                  <strong>Fecha:</strong> <%= new Date(r.fecha).toLocaleDateString() %> | 
                  <strong>Horario:</strong> <%= r.hora_inicio.slice(0,5) %> - <%= r.hora_fin.slice(0,5) %>
                </p>
                <p class="small text-muted mb-1">
                  <strong>Personas:</strong> <%= r.num_personas %> | 
                  <strong>Servicios Adicionales:</strong> CRC <%= Number(r.costo_servicios || 0).toLocaleString() %>
                </p>
                <!-- INVITADOS ASOCIADOS -->
                <% if (r.lista_invitados && r.lista_invitados.length > 0 && r.lista_invitados[0].nombre) { %>
                  <p class="small text-muted mb-0">
                    <strong>Invitados:</strong> 
                    <% r.lista_invitados.forEach(inv => { %>
                      <span class="badge bg-light text-dark border me-1"><%= inv.nombre %> (<%= inv.cedula %>)</span>
                    <% }) %>
                  </p>
                <% } %>
              </div>
              <% if (estadoActual === 'activa') { %>
                <div class="d-flex gap-2 align-items-center">
                  <a href="/socio/reservas/editar/<%= r.id %>" class="btn btn-sm btn-modern-edit">
                    <i class="bi bi-pencil-square me-1"></i> Modificar
                  </a>
                  <form action="/socio/reservas/cancelar" method="POST" class="form-confirmar"
                        data-confirm-title="Cancelar Reserva"
                        data-confirm-msg="¿Seguro que deseas cancelar tu reserva para <strong><%= r.nombre_instalacion %></strong>? El espacio quedará liberado inmediatamente."
                        data-confirm-btn="Sí, Cancelar Reserva"
                        data-confirm-type="danger"
                        data-confirm-icon="bi-calendar-x-fill">
                    <input type="hidden" name="id" value="<%= r.id %>">
                    <button type="submit" class="btn btn-sm btn-modern-danger">
                      <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                  </form>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- COLUMNA LATERAL: INVITADOS Y NUEVA RESERVA -->
  <div class="col-lg-4">
    <!-- INVITADOS DEL MES -->
    <div class="custom-card mb-3 text-center">
      <h6 class="fw-bold mb-2">Invitados del Mes</h6>
      <div class="d-flex justify-content-around my-2 text-muted small">
        <div>
          <span>Permitidos</span><br>
          <strong class="fs-5 text-dark"><%= limiteInvitados %></strong>
        </div>
        <div>
          <span>Registrados</span><br>
          <strong class="fs-5 text-dark"><%= totalInvitadosMes %></strong>
        </div>
      </div>
      <div class="progress mt-2" style="height: 8px;">
        <div class="progress-bar bg-success" style="width: <%= Math.min(100, (totalInvitadosMes / (limiteInvitados || 1)) * 100) %>%"></div>
      </div>
    </div>

    <!-- BOTON AGREGAR INVITADO -->
    <div class="custom-card mb-3 text-center">
      <p class="small text-muted mb-2">¿Quieres agregar nuevos invitados?</p>
      <a href="/socio/reservar" class="btn-dark-pill btn-sm-pill w-100">Nuevo Invitado</a>
    </div>

    <!-- BOTON NUEVA RESERVA -->
    <div class="custom-card text-center">
      <p class="small text-muted mb-2">¿Quieres realizar una nueva reserva?</p>
      <a href="/socio/reservar" class="btn-dark-pill btn-sm-pill w-100">Realizar Reserva</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
