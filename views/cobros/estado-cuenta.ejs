<%- include('../layouts/header') %>

<div class="row g-4 my-4 justify-content-center">
  <!-- TARJETA IZQUIERDA: PERIODO ACTUAL -->
  <div class="col-lg-7">
    <div class="custom-card p-4 p-md-5 h-100">
      <h4 class="fw-bold mb-4">Periodo Actual</h4>

      <div class="mb-4">
        <span class="text-muted small">Saldo Pendiente:</span>
        <h2 class="fw-bold text-dark mb-3">CRC <%= Number(estadoActual.total_pagar).toLocaleString() %></h2>

        <p class="mb-2"><strong>Fecha Límite del Pago:</strong> <%= new Date(estadoActual.fecha_limite_pago).toLocaleDateString() %></p>
        <p class="mb-2"><strong>Cuota de la Membresía:</strong> CRC <%= Number(estadoActual.cuota_membresia).toLocaleString() %></p>
        <p class="mb-3"><strong>Servicios Adicionales:</strong> CRC <%= Number(estadoActual.cargos_servicios).toLocaleString() %></p>

        <div class="d-flex align-items-center gap-2 mt-3">
          <span class="fw-bold me-2">Estado:</span>
          <% if (estadoActual.estado === 'pagado') { %>
            <span class="badge bg-success px-3 py-2">PAGADO</span>
          <% } else if (estadoActual.estado === 'pendiente') { %>
            <span class="badge bg-warning text-dark px-3 py-2">PENDIENTE</span>
          <% } else { %>
            <span class="badge bg-danger px-3 py-2">VENCIDO</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- TARJETA DERECHA: ACCIONES Y RESUMEN -->
  <div class="col-lg-4">
    <div class="custom-card mb-4 text-center">
      <span class="fs-4 d-block mb-1">📅</span>
      <h6 class="fw-bold mb-3">Periodos Anteriores</h6>
      <a href="/socio/periodos-anteriores" class="btn-dark-pill btn-sm-pill w-100">Ver Tabla</a>
    </div>

    <div class="custom-card text-center">
      <span class="fs-4 d-block mb-1">📄</span>
      <h6 class="fw-bold mb-3">Descargar Resumen PDF</h6>
      <a href="/socio/descargar-pdf/<%= estadoActual.id || 1 %>" class="btn-dark-pill btn-sm-pill w-100">Descargar PDF</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
