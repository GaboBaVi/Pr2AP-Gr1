<%- include('../layouts/header') %>

<div class="row my-4">
  <div class="col-12">
    <div class="custom-card p-4">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">Historial de Periodos Anteriores</h4>
        <div class="d-flex gap-2 align-items-center">
          <input type="text" class="form-control form-control-custom" style="width: 250px;" placeholder="Buscar mes o periodo..." id="busquedaHistorial" onkeyup="filtrarHistorial()">
          <a href="/socio/estado-cuenta" class="btn-volver"><i class="bi bi-arrow-left"></i> Volver</a>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle" id="tablaHistorial">
          <thead class="table-light">
            <tr>
              <th>Periodo / Mes</th>
              <th>Fecha de Pago</th>
              <th>Cuota Membresía</th>
              <th>Servicios Adicionales</th>
              <th>Total Facturado</th>
              <th>Estado</th>
              <th class="text-end">Comprobante</th>
            </tr>
          </thead>
          <tbody>
            <% if (historial && historial.length > 0) { %>
              <% historial.forEach(h => { %>
                <tr>
                  <td class="fw-bold"><%= h.periodo %></td>
                  <td><%= h.fecha_pago ? new Date(h.fecha_pago).toLocaleDateString() : 'Pendiente' %></td>
                  <td>CRC <%= Number(h.cuota_membresia).toLocaleString() %></td>
                  <td>CRC <%= Number(h.cargos_servicios).toLocaleString() %></td>
                  <td class="fw-bold">CRC <%= Number(h.total_pagar).toLocaleString() %></td>
                  <td>
                    <span class="badge bg-<%= h.estado === 'pagado' ? 'success' : (h.estado === 'pendiente' ? 'warning text-dark' : 'danger') %>">
                      <%= h.estado.toUpperCase() %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/socio/descargar-pdf/<%= h.id %>" class="btn-dark-pill btn-sm-pill">Descargar PDF</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">No tienes periodos registrados en el historial todavía.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
function filtrarHistorial() {
  const query = document.getElementById('busquedaHistorial').value.toLowerCase();
  const rows = document.querySelectorAll('#tablaHistorial tbody tr');
  rows.forEach(r => {
    const text = r.innerText.toLowerCase();
    r.style.display = text.includes(query) ? '' : 'none';
  });
}
</script>

<%- include('../layouts/footer') %>
