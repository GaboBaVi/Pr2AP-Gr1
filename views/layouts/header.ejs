<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Club Valle Alto - Sistema de Gestión</title>
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Estilos personalizados -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="<%= usuario ? (usuario.rol === 'socio' ? '/socio/dashboard' : '/admin/dashboard') : '/' %>">
        <img src="/img/logo.png" alt="Club Valle Alto" class="brand-logo" onerror="this.src='/img/logo-simple.png'">
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="navContent">
        <ul class="navbar-nav align-items-center">
          <% if (!usuario) { %>
            <li class="nav-item"><a class="nav-link-custom" href="/auth/login">Mis reservas</a></li>
            <li class="nav-item"><a class="nav-link-custom" href="/auth/login">Estado de Cuentas</a></li>
            <li class="nav-item ms-lg-3"><a class="btn-header-action" href="/auth/login">Iniciar Sesión</a></li>
          <% } else if (usuario.rol === 'socio') { %>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/socio/perfil') ? 'active' : '' %>" href="/auth/perfil">Mi perfil</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/socio/reservas') ? 'active' : '' %>" href="/socio/reservas">Mis reservas</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/socio/estado-cuenta') ? 'active' : '' %>" href="/socio/estado-cuenta">Estado de Cuentas</a></li>
            <li class="nav-item ms-lg-3">
              <button type="button" class="btn-header-action" data-bs-toggle="modal" data-bs-target="#modalCerrarSesion">
                Cerrar Sesión
              </button>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/socios') ? 'active' : '' %>" href="/admin/socios">Socios</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/instalaciones') ? 'active' : '' %>" href="/admin/instalaciones">Instalaciones</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/cobros') ? 'active' : '' %>" href="/admin/cobros">Cobros</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/notificaciones') ? 'active' : '' %>" href="/admin/notificaciones">Notificaciones</a></li>
            <li class="nav-item ms-lg-3">
              <button type="button" class="btn-header-action bg-warning text-dark border-0" data-bs-toggle="modal" data-bs-target="#modalCerrarSesion">
                Cerrar Sesión
              </button>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- MODAL GLOBAL DE CONFIRMACIÓN ELEGANTE Y ESTANDARIZADO -->
  <div class="modal fade" id="modalConfirmacionGlobal" tabindex="-1" aria-labelledby="modalConfirmacionTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
      <div class="modal-content custom-card p-4 text-center border-0 shadow-lg">
        <div class="d-flex justify-content-center mb-2">
          <div id="modalConfirmacionIconBox" class="modal-icon-badge danger">
            <i id="modalConfirmacionIcon" class="bi bi-exclamation-triangle-fill"></i>
          </div>
        </div>
        <h5 class="fw-bold mb-2 text-dark" id="modalConfirmacionTitulo">¿Confirmar Acción?</h5>
        <div class="text-muted small mb-4 px-2" id="modalConfirmacionMensaje">¿Estás seguro de que deseas continuar con esta acción?</div>
        <div class="d-flex justify-content-center gap-2">
          <button type="button" class="btn btn-secondary btn-cancel-modal px-4" data-bs-dismiss="modal" id="modalConfirmacionBtnCancelar">Cancelar</button>
          <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" id="modalConfirmacionBtnAceptar">Aceptar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL DE CONFIRMACION PARA CERRAR SESION -->
  <% if (usuario) { %>
    <div class="modal fade" id="modalCerrarSesion" tabindex="-1" aria-labelledby="modalCerrarSesionLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content custom-card p-4 text-center border-0 shadow-lg">
          <div class="d-flex justify-content-center mb-2">
            <div class="modal-icon-badge dark">
              <i class="bi bi-box-arrow-right"></i>
            </div>
          </div>
          <h5 class="fw-bold mb-2 text-dark" id="modalCerrarSesionLabel">Cerrar Sesión</h5>
          <p class="text-muted small mb-4 px-2">¿Estás seguro(a) de que deseas salir de tu cuenta en Club Valle Alto?</p>
          <div class="d-flex justify-content-center gap-2">
            <button type="button" class="btn btn-secondary btn-cancel-modal px-4" data-bs-dismiss="modal">Cancelar</button>
            <a href="/auth/logout" class="btn-dark-pill px-4">Sí, Cerrar Sesión</a>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <main class="container my-4 flex-grow-1">
