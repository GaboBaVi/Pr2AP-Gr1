<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Club Valle Alto - Sistema de Gestion</title>
  <!-- Bootstrap 5 CSS CDN para grid y responsividad -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Estilos personalizados coincidentes con el prototipo -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container-fluid">
      <a class="navbar-brand" href="<%= usuario ? (usuario.rol === 'socio' ? '/socio/dashboard' : '/admin/dashboard') : '/' %>">
        <img src="/img/logo.png" alt="Club Valle Alto" class="brand-logo" onerror="this.src='/img/logo-simple.png'">
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="navContent">
        <ul class="navbar-nav align-items-center">
          <% if (!usuario) { %>
            <li class="nav-item"><a class="nav-link-custom" href="/auth/login">Mis reservas</a></li>
            <li class="nav-item"><a class="nav-link-custom" href="/auth/login">Estado de Cuentas</a></li>
            <li class="nav-item ms-lg-3"><a class="btn-header-action" href="/auth/login">Iniciar Sesión</a></li>
          <% } else if (usuario.rol === 'socio') { %>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/socio/perfil') ? 'active' : '' %>" href="/auth/perfil">Mi perfil</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/socio/reservas') ? 'active' : '' %>" href="/socio/reservas">Mis reservas</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/socio/estado-cuenta') ? 'active' : '' %>" href="/socio/estado-cuenta">Estado de Cuentas</a></li>
            <li class="nav-item ms-lg-3"><a class="btn-header-action" href="/auth/logout">Cerrar Sesión</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/socios') ? 'active' : '' %>" href="/admin/socios">Socios</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/instalaciones') ? 'active' : '' %>" href="/admin/instalaciones">Instalaciones</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/cobros') ? 'active' : '' %>" href="/admin/cobros">Cobros</a></li>
            <li class="nav-item"><a class="nav-link-custom <%= urlActual.includes('/admin/notificaciones') ? 'active' : '' %>" href="/admin/notificaciones">Notificaciones</a></li>
            <li class="nav-item ms-lg-3"><a class="btn-header-action bg-warning text-dark" href="/auth/logout">Cerrar Sesión</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container my-4 flex-grow-1">
